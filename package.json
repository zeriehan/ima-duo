{
  "name": "ima-duo",
  "version": "0.12.0",
  "description": "Obsidian <-> IMA 双向同步插件（推送文件/文件夹到知识库或笔记，拉取个人笔记到 vault）",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "builtin-modules": "^4.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "esbuild": "^0.23.0",
    "obsidian": "^1.7.0"
  }
}
